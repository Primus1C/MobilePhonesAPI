// Запускает выгрузку порции номенклатуры в FinCore.
//
// Параметры:
//  Команда - КомандаФормы - команда «Выполнить обмен».
//
&НаКлиенте
Процедура ВыполнитьОбмен(Команда)
	
	Результат = ВыполнитьОбменНаСервере();
	ПоказатьОповещениеПользователя("Обмен FinCore", , Результат.Сообщение);
	
КонецПроцедуры

// Вызывает серверный обмен с FinCore.
//
// Возвращаемое значение:
//  Структура - результат FinCoreОбменHTTP.ВыполнитьОбмен().
//
&НаСервере
Функция ВыполнитьОбменНаСервере()
	
	Возврат FinCoreОбменHTTP.ВыполнитьОбмен();
	
КонецФункции

#Область ПрограммныйИнтерфейс

// Возвращает параметры HTTP-обмена с FinCore.
// АдресСервиса, Пользователь и Пароль заполняются перед запуском обмена.
//
// Возвращаемое значение:
//  Структура:
//   * АдресСервиса - Строка - URL публикации, например https://server/base/hs/Exchange/AllInOne;
//   * Пользователь - Строка - пользователь публикации HTTP-сервиса;
//   * Пароль       - Строка - пароль пользователя публикации;
//   * Таймаут      - Число - таймаут HTTP-соединения в секундах;
//   * РазмерПорции - Число - максимум объектов в одном POST;
//   * ИмяУзла      - Строка - наименование узла-получателя плана обмена.
//
Функция ПараметрыОбмена() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("АдресСервиса", "");
	Параметры.Вставить("Пользователь", "");
	Параметры.Вставить("Пароль", "");
	Параметры.Вставить("Таймаут", 60);
	Параметры.Вставить("РазмерПорции", 10);
	Параметры.Вставить("ИмяУзла", "FinCore");
	Возврат Параметры;
	
КонецФункции

// Выгружает порцию изменений номенклатуры в FinCore и снимает регистрацию по GUID из ответа.
//
// Возвращаемое значение:
//  Структура:
//   * Успех        - Булево - Истина, если пакет отправлен и обработан без транспортной ошибки;
//   * Сообщение    - Строка - краткий результат для пользователя;
//   * Выгружено    - Число - сколько объектов ушло в пакете;
//   * Подтверждено - Число - сколько GUID вернулось в ответе.
//
Функция ВыполнитьОбмен() Экспорт
	
	Результат = Новый Структура("Успех, Сообщение, Выгружено, Подтверждено", Ложь, "", 0, 0);
	
	Параметры = ПараметрыОбмена();
	Если Не ЗначениеЗаполнено(Параметры.АдресСервиса) Тогда
		Результат.Сообщение = "Не заполнен адрес сервиса FinCore в ПараметрыОбмена().";
		Возврат Результат;
	КонецЕсли;
	
	Узел = УзелПолучатель(Параметры.ИмяУзла);
	Если Не ЗначениеЗаполнено(Узел) Тогда
		ТекстОшибки = СтрШаблон("Не найден узел плана обмена с наименованием %1.", Параметры.ИмяУзла);
		ЗаписатьОшибкуОбмена("", Неопределено, ТекстОшибки);
		Результат.Сообщение = ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	Пакет = СобратьПакетНоменклатуры(Узел, Параметры.РазмерПорции);
	Если Пакет.Количество() = 0 Тогда
		Результат.Успех = Истина;
		Результат.Сообщение = "Нет изменений номенклатуры для выгрузки в FinCore.";
		Возврат Результат;
	КонецЕсли;
	
	Результат.Выгружено = Пакет.Количество();
	
	Попытка
		ОтветHTTP = ОтправитьПакет(Параметры, Пакет);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьОшибкуОбмена("", Неопределено, ТекстОшибки);
		Результат.Сообщение = ТекстОшибки;
		Возврат Результат;
	КонецПопытки;
	
	Если ОтветHTTP.КодСостояния < 200 Или ОтветHTTP.КодСостояния > 299 Тогда
		ТекстОшибки = СтрШаблон("HTTP %1: %2", ОтветHTTP.КодСостояния, Лев(ОтветHTTP.ТелоОтвета, 500));
		ЗаписатьОшибкуОбмена("", Неопределено, ТекстОшибки);
		Результат.Сообщение = ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	ПодтвержденныеGUID = ПрочитатьПодтвержденныеGUID(ОтветHTTP.ТелоОтвета);
	СнятьРегистрациюПоGUID(Узел, Пакет, ПодтвержденныеGUID);
	
	Результат.Успех = Истина;
	Результат.Подтверждено = ПодтвержденныеGUID.Количество();
	Результат.Сообщение = СтрШаблон("Выгружено %1, подтверждено %2.", Результат.Выгружено, Результат.Подтверждено);
	Возврат Результат;
	
КонецФункции

// Обработчик регламентного задания ОбменFinCore.
//
Процедура ВыполнитьОбменРегламент() Экспорт
	
	ВыполнитьОбмен();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ищет узел-получатель по наименованию, кроме предопределённого «этот узел».
//
// Параметры:
//  ИмяУзла - Строка - наименование узла, обычно "FinCore".
//
// Возвращаемое значение:
//  ПланОбменаСсылка.ОбменFinCore - найденный узел или пустая ссылка.
//
Функция УзелПолучатель(ИмяУзла)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОбменFinCore.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.ОбменFinCore КАК ОбменFinCore
	|ГДЕ
	|	НЕ ОбменFinCore.ЭтотУзел
	|	И ОбменFinCore.Наименование = &ИмяУзла";
	Запрос.УстановитьПараметр("ИмяУзла", ИмяУзла);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ПланыОбмена.ОбменFinCore.ПустаяСсылка();
	
КонецФункции

// Собирает порцию изменённой номенклатуры: группы ближе к корню, затем элементы.
//
// Параметры:
//  Узел         - ПланОбменаСсылка.ОбменFinCore - узел-получатель;
//  РазмерПорции - Число - максимум объектов в пакете.
//
// Возвращаемое значение:
//  Массив из Структура - объекты для JSON.
//
Функция СобратьПакетНоменклатуры(Узел, РазмерПорции)
	
	Лимит = Формат(РазмерПорции, "ЧГ=0");
	Если Не ЗначениеЗаполнено(Лимит) Тогда
		Лимит = "10";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ %1
		|	Изменения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура.Изменения КАК Изменения
		|ГДЕ
		|	Изменения.Узел = &Узел",
		Лимит);
	Запрос.УстановитьПараметр("Узел", Узел);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Таблица.Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Уровень", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Данные");
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Попытка
			ОбъектНоменклатуры = СтрокаТаблицы.Ссылка.ПолучитьОбъект();
			Если ОбъектНоменклатуры = Неопределено Тогда
				СтрокаТаблицы.ЭтоГруппа = Ложь;
				СтрокаТаблицы.Уровень = 0;
				СтрокаТаблицы.Данные = СтруктураУдаленияНоменклатуры(СтрокаТаблицы.Ссылка);
			Иначе
				СтрокаТаблицы.ЭтоГруппа = ОбъектНоменклатуры.ЭтоГруппа;
				СтрокаТаблицы.Уровень = УровеньИерархии(ОбъектНоменклатуры.Родитель);
				СтрокаТаблицы.Данные = НоменклатураВСтруктуру(ОбъектНоменклатуры, 0);
			КонецЕсли;
		Исключение
			ЗаписатьОшибкуОбмена(
				XMLСтрока(СтрокаТаблицы.Ссылка.УникальныйИдентификатор()),
				СтрокаТаблицы.Ссылка,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
	Таблица.Сортировать("ЭтоГруппа Убыв, Уровень Возр");
	
	Пакет = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.Данные <> Неопределено Тогда
			Пакет.Добавить(СтрокаТаблицы.Данные);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Пакет;
	
КонецФункции

// Считает глубину иерархии номенклатуры от корня.
//
// Параметры:
//  Родитель - СправочникСсылка.Номенклатура - родитель элемента.
//
// Возвращаемое значение:
//  Число - количество родителей до корня.
//
Функция УровеньИерархии(Родитель)
	
	Уровень = 0;
	ТекущийРодитель = Родитель;
	Пока ЗначениеЗаполнено(ТекущийРодитель) Цикл
		Уровень = Уровень + 1;
		ТекущийРодитель = ТекущийРодитель.Родитель;
		Если Уровень > 20 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Уровень;
	
КонецФункции

// Формирует JSON-структуру физического удаления номенклатуры.
//
// Параметры:
//  Ссылка - СправочникСсылка.Номенклатура - удалённый объект.
//
// Возвращаемое значение:
//  Структура - GUID, Type, DelMark = "1".
//
Функция СтруктураУдаленияНоменклатуры(Ссылка)
	
	Данные = Новый Структура;
	Данные.Вставить("GUID", XMLСтрока(Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("Type", "Номенклатура");
	Данные.Вставить("DelMark", "1");
	Возврат Данные;
	
КонецФункции

// Сериализует номенклатуру: стандартные поля, Parent вложенно, совпадающие примитивы шапки.
//
// Параметры:
//  ОбъектНоменклатуры - СправочникОбъект.Номенклатура - записываемый объект;
//  Уровень            - Число - глубина рекурсии по родителю.
//
// Возвращаемое значение:
//  Структура - представление объекта для JSON.
//
Функция НоменклатураВСтруктуру(ОбъектНоменклатуры, Уровень)
	
	Данные = Новый Структура;
	Данные.Вставить("GUID", XMLСтрока(ОбъектНоменклатуры.Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("Type", "Номенклатура");
	Данные.Вставить("DelMark", ?(ОбъектНоменклатуры.ПометкаУдаления, "1", "0"));
	Данные.Вставить("Code", ОбъектНоменклатуры.Код);
	Данные.Вставить("Description", ОбъектНоменклатуры.Наименование);
	Данные.Вставить("IsFolder", ОбъектНоменклатуры.ЭтоГруппа);
	
	Если ЗначениеЗаполнено(ОбъектНоменклатуры.Родитель) И Уровень < 20 Тогда
		ОбъектРодителя = ОбъектНоменклатуры.Родитель.ПолучитьОбъект();
		Если ОбъектРодителя = Неопределено Тогда
			Данные.Вставить("Parent", Неопределено);
		Иначе
			Данные.Вставить("Parent", НоменклатураВСтруктуру(ОбъектРодителя, Уровень + 1));
		КонецЕсли;
	Иначе
		Данные.Вставить("Parent", Неопределено);
	КонецЕсли;
	
	Если ОбъектНоменклатуры.ЭтоГруппа Тогда
		Данные.Вставить("ВыводитьИзАссортимента", ОбъектНоменклатуры.ВыводитьИзАссортимента);
	Иначе
		Данные.Вставить("SKU", ОбъектНоменклатуры.SKU);
		Данные.Вставить("Вес", ОбъектНоменклатуры.Вес);
		Данные.Вставить("Описание", ОбъектНоменклатуры.Описание);
		Данные.Вставить("Услуги", ОбъектНоменклатуры.Услуги);
		Данные.Вставить("УчетПоСериям", ОбъектНоменклатуры.УчетПоСериям);
		Данные.Вставить("ЗапретОтгрузки", ОбъектНоменклатуры.ЗапретОтгрузки);
		Данные.Вставить("Блок", ОбъектНоменклатуры.Блок);
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

// Отправляет JSON-пакет POST на HTTP-сервис FinCore с Basic-авторизацией публикации.
//
// Параметры:
//  Параметры - Структура - параметры из ПараметрыОбмена();
//  Пакет     - Массив - объекты выгрузки.
//
// Возвращаемое значение:
//  Структура:
//   * КодСостояния - Число;
//   * ТелоОтвета   - Строка.
//
Функция ОтправитьПакет(Параметры, Пакет)
	
	ДанныеURL = РазобратьАдресСервиса(Параметры.АдресСервиса);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("Accept", "application/json");
	
	Если ДанныеURL.HTTPS Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	Иначе
		ЗащищенноеСоединение = Неопределено;
	КонецЕсли;
	
	Соединение = Новый HTTPСоединение(
		ДанныеURL.Сервер,
		ДанныеURL.Порт,
		Параметры.Пользователь,
		Параметры.Пароль,
		,
		Параметры.Таймаут,
		ЗащищенноеСоединение);
	
	ЗапросHTTP = Новый HTTPЗапрос(ДанныеURL.Адрес, Заголовки);
	ЗапросHTTP.УстановитьТелоИзСтроки(СтруктураВJSON(Пакет), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Ответ = Соединение.ВызватьHTTPМетод("POST", ЗапросHTTP);
	
	Возврат Новый Структура("КодСостояния,ТелоОтвета", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
	
КонецФункции

// Разбирает URL сервиса на схему, хост, порт и путь.
//
// Параметры:
//  Адрес - Строка - полный URL, например https://server/base/hs/Exchange/AllInOne.
//
// Возвращаемое значение:
//  Структура:
//   * HTTPS  - Булево;
//   * Сервер - Строка;
//   * Порт   - Число;
//   * Адрес  - Строка - путь ресурса.
//
Функция РазобратьАдресСервиса(Адрес)
	
	СтрокаURL = СокрЛП(Строка(Адрес));
	НижнийURL = НРег(СтрокаURL);
	
	Если СтрНачинаетсяС(НижнийURL, "https://") Тогда
		HTTPS = Истина;
		БезСхемы = Сред(СтрокаURL, 9);
		Порт = 443;
	ИначеЕсли СтрНачинаетсяС(НижнийURL, "http://") Тогда
		HTTPS = Ложь;
		БезСхемы = Сред(СтрокаURL, 8);
		Порт = 80;
	Иначе
		ВызватьИсключение "АдресСервиса должен начинаться с http:// или https://.";
	КонецЕсли;
	
	ПозицияПути = СтрНайти(БезСхемы, "/");
	Если ПозицияПути = 0 Тогда
		Хост = БезСхемы;
		АдресРесурса = "/";
	Иначе
		Хост = Лев(БезСхемы, ПозицияПути - 1);
		АдресРесурса = Сред(БезСхемы, ПозицияПути);
	КонецЕсли;
	
	ПозицияПорта = СтрНайти(Хост, ":");
	Если ПозицияПорта > 0 Тогда
		Порт = Число(Сред(Хост, ПозицияПорта + 1));
		Хост = Лев(Хост, ПозицияПорта - 1);
	КонецЕсли;
	
	Если Хост = "" Тогда
		ВызватьИсключение "В АдресСервиса не указан сервер.";
	КонецЕсли;
	
	Возврат Новый Структура("HTTPS,Сервер,Порт,Адрес", HTTPS, Хост, Порт, АдресРесурса);
	
КонецФункции

// Сериализует значение в JSON-строку.
//
// Параметры:
//  Значение - Произвольный - структура или массив.
//
// Возвращаемое значение:
//  Строка - JSON.
//
Функция СтруктураВJSON(Значение)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

// Читает из тела ответа массив GUID, по которым можно снять регистрацию.
//
// Параметры:
//  ТелоОтвета - Строка - JSON-массив строк или объектов с полем GUID.
//
// Возвращаемое значение:
//  Соответствие - ключ GUID в верхнем регистре, значение Истина.
//
Функция ПрочитатьПодтвержденныеGUID(ТелоОтвета)
	
	Результат = Новый Соответствие;
	Если Не ЗначениеЗаполнено(ТелоОтвета) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
	
	Если ТипЗнч(ДанныеОтвета) = Тип("Массив") Тогда
		Для Каждого Элемент Из ДанныеОтвета Цикл
			ДобавитьGUIDВСоответствие(Результат, Элемент);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Добавляет GUID из элемента ответа в соответствие подтверждённых.
//
// Параметры:
//  Результат - Соответствие - накопитель GUID;
//  Элемент   - Строка, Структура - элемент JSON-массива.
//
Процедура ДобавитьGUIDВСоответствие(Результат, Элемент)
	
	Если ТипЗнч(Элемент) = Тип("Строка") Тогда
		Если ЗначениеЗаполнено(Элемент) Тогда
			Результат.Вставить(ВРег(СокрЛП(Элемент)), Истина);
		КонецЕсли;
	ИначеЕсли ТипЗнч(Элемент) = Тип("Структура") И Элемент.Свойство("GUID") Тогда
		Если ЗначениеЗаполнено(Элемент.GUID) Тогда
			Результат.Вставить(ВРег(СокрЛП(Строка(Элемент.GUID))), Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Снимает регистрацию изменений только по GUID, вернувшимся в ответе.
//
// Параметры:
//  Узел                - ПланОбменаСсылка.ОбменFinCore - узел-получатель;
//  Пакет               - Массив из Структура - отправленные объекты;
//  ПодтвержденныеGUID  - Соответствие - GUID из ответа приёмника.
//
Процедура СнятьРегистрациюПоGUID(Узел, Пакет, ПодтвержденныеGUID)
	
	Для Каждого ДанныеОбъекта Из Пакет Цикл
		
		Гуид = "";
		Если ТипЗнч(ДанныеОбъекта) = Тип("Структура") И ДанныеОбъекта.Свойство("GUID") Тогда
			Гуид = СокрЛП(Строка(ДанныеОбъекта.GUID));
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Гуид) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПодтвержденныеGUID.Получить(ВРег(Гуид)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Ссылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Гуид));
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

// Пишет строку в регистр ошибок обмена FinCore.
//
// Параметры:
//  Гуид         - Строка - GUID источника;
//  ОбъектСсылка - СправочникСсылка.Номенклатура, Неопределено - связанный объект;
//  ТекстОшибки  - Строка - описание ошибки.
//
Процедура ЗаписатьОшибкуОбмена(Гуид, ОбъектСсылка, ТекстОшибки)
	
	МенеджерЗаписи = РегистрыСведений.ОшибкиОбменаFinCore.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Дата = ТекущаяДатаСеанса();
	МенеджерЗаписи.GUID = Гуид;
	Если ОбъектСсылка <> Неопределено Тогда
		МенеджерЗаписи.Объект = ОбъектСсылка;
	КонецЕсли;
	МенеджерЗаписи.ТекстОшибки = ТекстОшибки;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

#КонецОбласти

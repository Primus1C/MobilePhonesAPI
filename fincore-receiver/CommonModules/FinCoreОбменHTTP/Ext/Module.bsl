#Область ПрограммныйИнтерфейс

// Принимает JSON-массив объектов обмена и записывает номенклатуру по GUID источника.
// В ответ попадают только GUID успешно записанных объектов; неизвестный Type не подтверждается.
//
// Параметры:
//  ТелоЗапроса - Строка - JSON-массив структур с полями GUID, Type, DelMark и данными номенклатуры.
//
// Возвращаемое значение:
//  Строка - JSON-массив GUID источника.
//
Функция ОбработатьВходящиеДанные(ТелоЗапроса) Экспорт
	
	ПодтвержденныеGUID = Новый Массив;
	
	Если Не ЗначениеЗаполнено(ТелоЗапроса) Тогда
		Возврат МассивВJSON(ПодтвержденныеGUID);
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
	ДанныеПакета = ПрочитатьJSON(ЧтениеJSON);
	
	Если ТипЗнч(ДанныеПакета) <> Тип("Массив") Тогда
		Возврат МассивВJSON(ПодтвержденныеGUID);
	КонецЕсли;
	
	Для Каждого ДанныеОбъекта Из ДанныеПакета Цикл
		
		Если ТипЗнч(ДанныеОбъекта) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		ТипОбъекта = ЗначениеСвойства(ДанныеОбъекта, "Type", "");
		Если ТипОбъекта <> "Номенклатура" Тогда
			Продолжить;
		КонецЕсли;
		
		Гуид = СокрЛП(Строка(ЗначениеСвойства(ДанныеОбъекта, "GUID", "")));
		Если Не ЗначениеЗаполнено(Гуид) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Если ЗаписатьНоменклатуру(ДанныеОбъекта, 0) Тогда
				ПодтвержденныеGUID.Добавить(Гуид);
			КонецЕсли;
		Исключение
			// GUID не в ответ — регистрацию на источнике не снимать
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат МассивВJSON(ПодтвержденныеGUID);
	
КонецФункции

// Формирует JSON с описанием ошибки для HTTP 500.
//
// Параметры:
//  ТекстОшибки - Строка - текст исключения.
//
// Возвращаемое значение:
//  Строка - JSON-объект {"error": "..."}.
//
Функция ОшибкаВJSON(ТекстОшибки) Экспорт
	
	Результат = Новый Структура("error", ТекстОшибки);
	Возврат СтруктураВJSON(Результат);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Записывает номенклатуру: поиск по GUID, создание с новым UUID, иерархия Parent, ОбменДанными.Загрузка.
//
// Параметры:
//  ДанныеОбъекта - Структура - поля пакета номенклатуры;
//  Уровень       - Число - глубина рекурсии по Parent.
//
// Возвращаемое значение:
//  Булево - Истина, если объект записан и GUID можно вернуть источнику.
//
Функция ЗаписатьНоменклатуру(ДанныеОбъекта, Уровень)
	
	Если Уровень > 20 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Гуид = СокрЛП(Строка(ЗначениеСвойства(ДанныеОбъекта, "GUID", "")));
	ЭтоУдаление = ЭтоПометкаУдаления(ЗначениеСвойства(ДанныеОбъекта, "DelMark", "0"));
	
	Ссылка = НайтиНоменклатуруПоGUID(Гуид);
	
	Если ЭтоУдаление Тогда
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Истина;
		КонецЕсли;
		ОбъектНоменклатуры = Ссылка.ПолучитьОбъект();
		Если ОбъектНоменклатуры = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		ОбъектНоменклатуры.ОбменДанными.Загрузка = Истина;
		ОбъектНоменклатуры.ПометкаУдаления = Истина;
		ОбъектНоменклатуры.Записать();
		Возврат Истина;
	КонецЕсли;
	
	ЭтоГруппа = БулевоСвойства(ДанныеОбъекта, "IsFolder");
	Родитель = Неопределено;
	ДанныеРодителя = ЗначениеСвойства(ДанныеОбъекта, "Parent", Неопределено);
	Если ТипЗнч(ДанныеРодителя) = Тип("Структура") Тогда
		Если Не ЗаписатьНоменклатуру(ДанныеРодителя, Уровень + 1) Тогда
			Возврат Ложь;
		КонецЕсли;
		ГуидРодителя = СокрЛП(Строка(ЗначениеСвойства(ДанныеРодителя, "GUID", "")));
		Родитель = НайтиНоменклатуруПоGUID(ГуидРодителя);
		Если ЗначениеЗаполнено(ГуидРодителя) И Не ЗначениеЗаполнено(Родитель) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ОбъектНоменклатуры = Ссылка.ПолучитьОбъект();
		Если ОбъектНоменклатуры = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ОбъектНоменклатуры.ЭтоГруппа <> ЭтоГруппа Тогда
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли ЭтоГруппа Тогда
		ОбъектНоменклатуры = Справочники.Номенклатура.СоздатьГруппу();
	Иначе
		ОбъектНоменклатуры = Справочники.Номенклатура.СоздатьЭлемент();
	КонецЕсли;
	
	ОбъектНоменклатуры.ОбменДанными.Загрузка = Истина;
	УстановитьРеквизитЕслиЕсть(ОбъектНоменклатуры, "GUID", Гуид);
	ОбъектНоменклатуры.Наименование = Строка(ЗначениеСвойства(ДанныеОбъекта, "Description", ОбъектНоменклатуры.Наименование));
	УстановитьКодЕслиЗаполнен(ОбъектНоменклатуры, ЗначениеСвойства(ДанныеОбъекта, "Code", Неопределено));
	ОбъектНоменклатуры.ПометкаУдаления = Ложь;
	Если ЗначениеЗаполнено(Родитель) Тогда
		ОбъектНоменклатуры.Родитель = Родитель;
	КонецЕсли;
	
	Если ЭтоГруппа Тогда
		УстановитьРеквизитЕслиЕсть(ОбъектНоменклатуры, "ВыводитьИзАссортимента", ЗначениеСвойства(ДанныеОбъекта, "ВыводитьИзАссортимента", Неопределено));
	Иначе
		УстановитьРеквизитЕслиЕсть(ОбъектНоменклатуры, "SKU", ЗначениеСвойства(ДанныеОбъекта, "SKU", Неопределено));
		УстановитьРеквизитЕслиЕсть(ОбъектНоменклатуры, "Вес", ЗначениеСвойства(ДанныеОбъекта, "Вес", Неопределено));
		УстановитьРеквизитЕслиЕсть(ОбъектНоменклатуры, "Описание", ЗначениеСвойства(ДанныеОбъекта, "Описание", Неопределено));
		УстановитьРеквизитЕслиЕсть(ОбъектНоменклатуры, "Услуги", ЗначениеСвойства(ДанныеОбъекта, "Услуги", Неопределено));
		УстановитьРеквизитЕслиЕсть(ОбъектНоменклатуры, "УчетПоСериям", ЗначениеСвойства(ДанныеОбъекта, "УчетПоСериям", Неопределено));
		УстановитьРеквизитЕслиЕсть(ОбъектНоменклатуры, "ЗапретОтгрузки", ЗначениеСвойства(ДанныеОбъекта, "ЗапретОтгрузки", Неопределено));
		УстановитьРеквизитЕслиЕсть(ОбъектНоменклатуры, "Блок", ЗначениеСвойства(ДанныеОбъекта, "Блок", Неопределено));
	КонецЕсли;
	
	ОбъектНоменклатуры.Записать();
	Возврат Истина;
	
КонецФункции

// Ищет номенклатуру приёмника по реквизиту GUID источника.
//
// Параметры:
//  Гуид - Строка - UUID объекта на источнике.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - найденная ссылка или пустая.
//
Функция НайтиНоменклатуруПоGUID(Гуид)
	
	Если Не ЗначениеЗаполнено(Гуид) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.GUID = &GUID";
	Запрос.УстановитьПараметр("GUID", Гуид);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.ПустаяСсылка();
	
КонецФункции

// Устанавливает реквизит объекта, если он есть в метаданных и значение заполнено смыслом.
//
// Параметры:
//  Объект        - СправочникОбъект.Номенклатура - записываемый объект;
//  ИмяРеквизита  - Строка - имя реквизита;
//  Значение      - Произвольный - новое значение; Неопределено — не менять.
//
Процедура УстановитьРеквизитЕслиЕсть(Объект, ИмяРеквизита, Значение)
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Объект.Метаданные().Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект[ИмяРеквизита] = Значение;
	
КонецПроцедуры

// Заполняет код справочника, если значение передано.
//
// Параметры:
//  Объект   - СправочникОбъект.Номенклатура - записываемый объект;
//  Значение - Произвольный - код из JSON.
//
Процедура УстановитьКодЕслиЗаполнен(Объект, Значение)
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Код = Значение;
	
КонецПроцедуры

// Возвращает значение свойства структуры или значение по умолчанию.
//
// Параметры:
//  Данные          - Структура - JSON-объект;
//  ИмяСвойства     - Строка - имя поля;
//  ЗначениеПоУмолчанию - Произвольный - если свойства нет.
//
// Возвращаемое значение:
//  Произвольный - значение поля.
//
Функция ЗначениеСвойства(Данные, ИмяСвойства, ЗначениеПоУмолчанию)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если Не Данные.Свойство(ИмяСвойства) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Данные[ИмяСвойства];
	
КонецФункции

// Приводит IsFolder из JSON к булеву.
//
// Параметры:
//  ДанныеОбъекта - Структура - JSON-объект.
//
// Возвращаемое значение:
//  Булево - признак группы.
//
Функция БулевоСвойства(ДанныеОбъекта, ИмяСвойства)
	
	Значение = ЗначениеСвойства(ДанныеОбъекта, ИмяСвойства, Ложь);
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат Строка(Значение) = "true" Или Строка(Значение) = "1";
	
КонецФункции

// Определяет, что объект нужно пометить на удаление.
//
// Параметры:
//  ЗначениеDelMark - Произвольный - поле DelMark из JSON.
//
// Возвращаемое значение:
//  Булево - Истина при "1"/Истина.
//
Функция ЭтоПометкаУдаления(ЗначениеDelMark)
	
	Если ТипЗнч(ЗначениеDelMark) = Тип("Булево") Тогда
		Возврат ЗначениеDelMark;
	КонецЕсли;
	
	Возврат Строка(ЗначениеDelMark) = "1";
	
КонецФункции

// Сериализует значение в JSON-строку.
//
// Параметры:
//  Значение - Произвольный - структура или массив.
//
// Возвращаемое значение:
//  Строка - JSON.
//
Функция СтруктураВJSON(Значение)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

// Сериализует массив GUID в JSON.
//
// Параметры:
//  МассивЗначений - Массив из Строка - GUID источника.
//
// Возвращаемое значение:
//  Строка - JSON-массив.
//
Функция МассивВJSON(МассивЗначений)
	
	Возврат СтруктураВJSON(МассивЗначений);
	
КонецФункции

#КонецОбласти

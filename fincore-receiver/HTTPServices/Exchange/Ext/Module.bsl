// POST /hs/Exchange/AllInOne — приём порции объектов обмена.

// Принимает JSON-пакет обмена и возвращает массив GUID успешно записанных объектов.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - тело JSON-массива объектов.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - 200 и JSON-массив GUID либо 500 с error.
//
Функция AllInOnePOST(Запрос)
	
	Тело = Запрос.ПолучитьТелоКакСтроку();
	Попытка
		ТелоОтвета = FinCoreОбменHTTP.ОбработатьВходящиеДанные(Тело);
		Ответ = Новый HTTPСервисОтвет(200);
	Исключение
		ТелоОтвета = FinCoreОбменHTTP.ОшибкаВJSON(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Ответ = Новый HTTPСервисОтвет(500);
	КонецПопытки;
	
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
	
КонецФункции
